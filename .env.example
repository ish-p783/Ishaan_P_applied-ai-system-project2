# Copy this file to ".env" and paste your Anthropic API key after the "=".
# Get a key at https://console.anthropic.com/ -> API Keys.
# The .env file is git-ignored, so your key never gets committed.
# NEVER put a real key in THIS file — .env.example IS committed to git.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: run the AI assistant offline, with no API credits, for demos.
# When true, the assistant answers without calling Claude; retrieval and the
# validation loop still run. Leave unset/false to use the live model.
PAWPAL_DEMO_MODE=false
